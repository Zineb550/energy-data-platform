# ------------------------------------------------------------
# EnergyInsight — files that must NOT go to GitHub
# ------------------------------------------------------------

# Secrets: database password and JWT secret live here.
# Only .env.example (no real values) is committed.
.env
.env.*
!.env.example

# Dependencies: reinstalled with "npm install" (package-lock.json IS committed)
node_modules/

# Build output (frontend: "npm run build")
dist/
build/
.vite/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage reports
coverage/
.nyc_output/
newman/

# Local uploads or temporary files
tmp/
temp/
*.tmp

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Editors and IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Personal preparation notes for the defense (kept out of the public repo)
soutenance-prep/
DEMO_SCRIPT.*
HOW_IT_WORKS.*
