# Copy this file to ".env" and adapt the values.

# Port of the API
PORT=4000

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/energy_insight

# Secret used to sign the login tokens (put any long random text)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Address of the React app (allowed by CORS)
CLIENT_URL=http://localhost:5173
