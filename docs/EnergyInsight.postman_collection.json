        {
          "name": "Run an analysis without saving it (preview)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "metrics: 1-4 indicators (agg: sum | avg | min | max | count). groupBy: column or null. chart: bar | line | pie | kpi | table. forecast: optional { periods } (needs a numeric time grouping such as year).\n\nAccess: user",
            "url": {
              "raw": "{{baseUrl}}/analyses/run",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analyses",
                "run"
              ],
              "query": [],
              "variable": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"datasetId\": 1,\n  \"config\": {\n    \"metrics\": [\n      {\n        \"agg\": \"avg\",\n        \"column\": \"renewables_share_energy\"\n      }\n    ],\n    \"groupBy\": \"year\",\n    \"filters\": [\n      {\n        \"column\": \"country\",\n        \"op\": \"eq\",\n        \"value\": \"Morocco\"\n      }\n    ],\n    \"sort\": \"label_asc\",\n    \"limit\": 50,\n    \"chart\": \"line\",\n    \"forecast\": {\n      \"periods\": 5\n    }\n  }\n}",
