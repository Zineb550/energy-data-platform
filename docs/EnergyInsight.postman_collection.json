            "description": "Access: user",
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ],
              "query": [],
              "variable": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sara Analyst\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Change my password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "The example keeps the same password, so the demo account still works after running the collection.\n\nAccess: user",
            "url": {
              "raw": "{{baseUrl}}/auth/me/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me",
                "password"
              ],
              "query": [],
              "variable": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Sara12345\",\n  \"newPassword\": \"Sara12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
